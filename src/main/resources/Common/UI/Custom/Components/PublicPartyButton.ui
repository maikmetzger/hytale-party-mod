$C = "../Common.ui";

@InputBoxStyle = ButtonStyle(
    Default: (Background: $C.@InputBoxBackground),
    Hovered: (Background: $C.@InputBoxHoveredBackground),
    Pressed: (Background: $C.@InputBoxSelectedBackground),
    Disabled: (Background: $C.@InputBoxBackground)
);

// Public party entry for the parties list
Button #Button {
    Style: @InputBoxStyle;
    Anchor: (Height: 52, Bottom: 6);
    Padding: (Horizontal: 12, Vertical: 8);
    LayoutMode: Left;

    // Party info container
    Group {
        LayoutMode: Top;
        FlexWeight: 1;

        // Party name
        Label #PartyName {
            Text: "Party Name";
            Style: (FontSize: 15, TextColor: #b7b8b9, VerticalAlignment: Center);
        }

        // Leader name
        Label #PartyLeader {
            Text: "Leader: Player";
            Style: (FontSize: 12, TextColor: #778292(0.8));
        }
    }

    // Access type icon
    Group #AccessIcon {
        Anchor: (Width: 20, Height: 20, Right: 8);
        Background: (TexturePath: "../Icons/Locked.png");
    }

    // Member count
    Label #MemberCount {
        Text: "4/8";
        Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center, HorizontalAlignment: End);
        Anchor: (Width: 50);
    }
}

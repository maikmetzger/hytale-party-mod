$C = "Common.ui";

$C.@PageOverlay {
    LayoutMode: Middle;

    $C.@DecoratedContainer {
        Anchor: (Width: 532);

        #Title {
            $C.@Title {
                @Text = "Party Menu";
            }
        }

        #Content {
            LayoutMode: Top;
            Padding: (Full: 16);

            Group {
                LayoutMode: Center;

                Group #PartyPanel {
                    Anchor: (Top: 16);
                    LayoutMode: Top;

                    Group #InviteSection {
                        LayoutMode: Top;
                        Anchor: (Top: 16);
                    }

                    Group #PartyMembersList {
                        LayoutMode: Top;
                        Anchor: (Top: 16);

                        Label {
                            @Text = "Party Members:";
                            Style: (FontSize: 18, RenderBold: true, TextColor: #bb3333);
                        }
                    }

                    Group #ActionButtons {
                        LayoutMode: Top;
                        Anchor: (Top: 16);
                    }

                    Group #PlayersList {
                        LayoutMode: Top;
                        Anchor: (Top: 16);
                    }
                }
            }
        }
    }
}

